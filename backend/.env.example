# ===================================================================
# Configuración de Variables de Entorno - Gym System (Backend)
# Copia este archivo como .env dentro del directorio backend/ o en la raíz:
#   cp .env.example .env
# ===================================================================

# --- Opción 1: PostgreSQL Local / Contenedor Docker ---
DB_URL=jdbc:postgresql://localhost:5432/gym_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Opción 2: Base de Datos Cloud (Supabase / Neon con SSL) ---
# DB_URL=jdbc:postgresql://db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
# DB_USER=postgres.<PROJECT-REF>
# DB_PASSWORD=tu_password_segura
